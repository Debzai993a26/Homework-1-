# Load data and metrics
@st.cache_data
def load_results():
    results = pd.read_csv("test_results.csv", index_col=0, parse_dates=True)
    with open("metrics.json", "r") as f:
        metrics = json.load(f)
    return results, metrics

try:
    results_df, metrics = load_results()
except Exception as e:
    st.error("Error loading data. Please ensure model training is complete.")
    st.stop()

# Header
st.title("📈 S&P 500 Stock Price Prediction Interface")
st.markdown("### Predicting tomorrow's market, today.")

# Reliability Formulas Section
with st.expander("🔬 View Prediction Reliability Formulas", expanded=False):
    st.markdown("To ensure reliability, we use standard financial engineering formulas:")
    st.latex(r"Daily\ Return\ (r_t) = \frac{Price_{t} - Price_{t-1}}{Price_{t-1}}")
    st.latex(r"Target\ Variable = r_{tomorrow} = \frac{Price_{tomorrow} - Price_{today}}{Price_{today}}")
    st.latex(r"Moving\ Average\ (MA_n) = \frac{1}{n} \sum_{i=0}^{n-1} Price_{t-i}")
    st.latex(r"Volatility\ (\sigma) = \sqrt{\frac{\sum (r_i - \bar{r})^2}{n-1}}")
    st.info("The model predicts the % move, which we then convert back to price: $Price_{pred} = Price_{today} \times (1 + r_{pred})$")

