# 2. Prediction Line Chart
st.markdown("### 📊 Market Predictions vs. Reality (2025)")
fig = go.Figure()

# Actual
fig.add_trace(go.Scatter(x=results_df.index, y=results_df['Close'], 
                         name='Real Price (Today)', line=dict(color='black', width=3)))

# XGBoost
fig.add_trace(go.Scatter(x=results_df.index, y=results_df['XGB_Pred'], 
                         name='XGBoost Prediction (Tomorrow)', line=dict(color='red', width=1.5, dash='dot')))

# Random Forest
fig.add_trace(go.Scatter(x=results_df.index, y=results_df['RF_Pred'], 
                         name='Random Forest Prediction (Tomorrow)', line=dict(color='blue', width=1.5, dash='dot')))

fig.update_layout(
    template="plotly_white",
    xaxis_title="Date",
    yaxis_title="S&P 500 Index Price ($)",
    hovermode="x unified",
    legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1),
    margin=dict(l=0, r=0, t=50, b=0),
    height=500
)
st.plotly_chart(fig, use_container_width=True)

# 3. Model Efficiency (Bar Chart)
st.markdown("### 🧬 Model Performance Comparison")
st.markdown("Comparing error rates on price targets. Accuracy has improved significantly since switching to percentage-based targets!")

perf_cols = st.columns(2)

with perf_cols[0]:
    # MAPE Bar Chart
    models = list(metrics.keys())
    mapes = [metrics[m]['MAPE'] for m in models]
    
    fig_mape = go.Figure(data=[
        go.Bar(x=models, y=mapes, marker_color=['red', 'blue'])
    ])
    fig_mape.update_layout(
        template="plotly_white",  # Match the line chart theme
        title="Average Percentage Error (%) - Lower is Better",
        yaxis_title="Error %",
        height=400
    )
    st.plotly_chart(fig_mape, use_container_width=True)

with perf_cols[1]:
    # RMSE Bar Chart
    rmses = [metrics[m]['RMSE'] for m in models]
    
    fig_rmse = go.Figure(data=[
        go.Bar(x=models, y=rmses, marker_color=['red', 'blue'])
    ])
    fig_rmse.update_layout(
        template="plotly_white",  # Match the line chart theme
        title="RMSE (Points off) - Lower is Better",
        yaxis_title="Index Points",
        height=400
    )
    st.plotly_chart(fig_rmse, use_container_width=True)

# 4. Expert Analysis
st.markdown("---")
st.markdown("### 🧠 Expert Analysis: Which Model Won?")

winner = "Random Forest" if metrics["Random Forest"]["MAPE"] < metrics["XGBoost"]["MAPE"] else "XGBoost"
loser = "XGBoost" if winner == "Random Forest" else "Random Forest"

st.write(f"Based on the 2025 test data, the **{winner}** model performed better.")

st.markdown(f"""
- **Reason 1: Outlier Handling**: {winner} is often more robust to sudden market "shocks" because its averaging method (Bagging) smooths out noisy data better than gradient boosting in simple configurations.
- **Reason 2: Ease of Fitting**: In a market index like the S&P 500, trends are often stable. Random Forest captures these non-linear relationships without over-fitting to small, random daily fluctuations as aggressively as {loser} might.
- **Comparison**: {winner} achieved a **{metrics[winner]['MAPE']:.2f}%** error rate, whereas {loser} was slightly higher at **{metrics[loser]['MAPE']:.2f}%**.
""")

