import pandas as pd
import numpy as np
from xgboost import XGBRegressor
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error, mean_absolute_percentage_error
import joblib
import json

def train_and_evaluate():
    # Load data
    train_df = pd.read_csv("train_data.csv", index_col=0, parse_dates=True)
    test_df = pd.read_csv("test_data.csv", index_col=0, parse_dates=True)
    
    # Define features and target
    features = ['Daily_Return', 'MA_5', 'MA_10', 'MA_20', 'Volatility']
    target = 'Target'
    
    X_train = train_df[features]
    y_train = train_df[target]
    X_test = test_df[features]
    y_test = test_df[target]
    
    # 1. XGBoost Model
    xgb_model = XGBRegressor(n_estimators=100, learning_rate=0.05, max_depth=5, random_state=42)
    xgb_model.fit(X_train, y_train)
    
    # 2. Random Forest Model
    rf_model = RandomForestRegressor(n_estimators=100, max_depth=10, random_state=42)
    rf_model.fit(X_train, y_train)
    
    # Predictions
    xgb_preds = xgb_model.predict(X_test)
    rf_preds = rf_model.predict(X_test)
    
    # Metrics (calculated on the predicted percentage change)
    # But for the final interface, we want to evaluate the price prediction
    xgb_preds_price = test_df['Close'] * (1 + xgb_preds)
    rf_preds_price = test_df['Close'] * (1 + rf_preds)
    
    # Real next day close for price evaluation
    # We need to fetch the real next day close from the original data if available
    # Or just use the Daily_Return target to reconstruct it
    y_test_price = test_df['Close'] * (1 + test_df[target])
    
    metrics = {
        "XGBoost": {
            "MSE": float(mean_squared_error(y_test_price, xgb_preds_price)),
            "RMSE": float(np.sqrt(mean_squared_error(y_test_price, xgb_preds_price))),
            "MAPE": float(mean_absolute_percentage_error(y_test_price, xgb_preds_price)) * 100
        },
        "Random Forest": {
            "MSE": float(mean_squared_error(y_test_price, rf_preds_price)),
            "RMSE": float(np.sqrt(mean_squared_error(y_test_price, rf_preds_price))),
            "MAPE": float(mean_absolute_percentage_error(y_test_price, rf_preds_price)) * 100
        }
    }
    
    # Save test predictions for visualization
    results_df = test_df.copy()
    results_df['XGB_Pred'] = xgb_preds_price
    results_df['RF_Pred'] = rf_preds_price
    results_df['Actual_Next_Day'] = y_test_price
    results_df.to_csv("test_results.csv")
    
    # Save metrics
    with open("metrics.json", "w") as f:
        json.dump(metrics, f, indent=4)
        
    print("Models trained and evaluated successfully.")
    print("\nMetrics:")
    print(json.dumps(metrics, indent=4))

if __name__ == "__main__":
    train_and_evaluate()
